# Create a 3CX API application; use its DN identifier and one-time secret.
PBX_URL=https://pbx.example.com
PBX_CLIENT_ID=
PBX_CLIENT_SECRET=
# multipart matches the original official example and this V20 Update 9 PBX.
# Choose urlencoded explicitly for deployments that require the newer example's format.
PBX_TOKEN_FORMAT=multipart
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=
# Set the bridge host's LAN IP so the badge can reach it.
BRIDGE_BIND_ADDRESS=127.0.0.1

# Separate badge control token: never reuse BRIDGE_TOKEN. Empty disables writes.
BRIDGE_CONTROL_TOKEN=
# Own user only, for confirmed presence and instant DND. Leave empty until authorized.
PBX_USER_USERNAME=100
PBX_USER_PASSWORD=
PBX_USER_SECURITY_CODE=
PBX_USER_REFRESH_TOKEN=

# Optional durable private grant outside Docker; Docker stack sets /data automatically.
PBX_USER_TOKEN_FILE=

# Optional incoming Apprise/rich webhook token; distinct from both bridge tokens.
# Empty disables POST /v1/notify. See docs/NOTIFICATIONS.md.
NOTIFY_TOKEN=
# Optional read-only ntfy HTTPS subscription. Leave all empty to disable it.
NTFY_URL=
NTFY_TOPIC=
NTFY_TOKEN=
